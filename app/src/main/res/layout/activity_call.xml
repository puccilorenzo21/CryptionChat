<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true"
    tools:context=".CallActivity">

    <!-- Sfondo Sfocato (Nuovo) -->
    <ImageView
        android:id="@+id/background_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Overlay scuro per garantire la leggibilità -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000" /> <!-- 65% Nero -->

    <!-- Badge Superiore "Chiamata Cifrata" -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_lock"
            app:tint="#A0AEC0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="Chiamata Protetta E2E"
            android:textAllCaps="true"
            android:textColor="#A0AEC0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Info Utente Centrale -->
    <LinearLayout
        android:id="@+id/user_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/controlsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profile_image"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="24dp"
            android:elevation="12dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="2dp"
            tools:src="@drawable/ic_person" />

        <TextView
            android:id="@+id/textUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="32dp"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="Lollo" />

        <!-- LAYOUT STATO (Squillando...) -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            tools:text="Squillando..." />

        <!-- LAYOUT CHIAMATA ATTIVA -->
        <LinearLayout
            android:id="@+id/active_call_info_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                tools:text="00:09" />

            <!-- Pillola Statistiche -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_call_stats_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/network_quality_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_signal_good"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/hd_audio_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/icon_background_circle"
                    android:backgroundTint="#4CAF50"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="HD"
                    android:textColor="#121212"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/textBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#E2E2E6"
                    android:textSize="12sp"
                    android:visibility="visible"
                    tools:text="▼10 ▲220 kbps" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Controlli Chiamata (Vetro/Fluttuanti) -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/actionLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMute"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="24dp"
            android:checkable="true"
            android:contentDescription="Muto"
            app:backgroundTint="@color/call_button_background"
            app:icon="@drawable/ic_mic"
            app:iconSize="32dp"
            app:iconTint="@color/call_button_icon_tint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeaker"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:checkable="true"
            android:contentDescription="Altoparlante"
            app:backgroundTint="@color/call_button_background"
            app:icon="@drawable/ic_volume_up"
            app:iconSize="32dp"
            app:iconTint="@color/call_button_icon_tint" />

    </LinearLayout>

    <!-- Pulsanti Azione (Riaggancia/Rispondi) -->
    <LinearLayout
        android:id="@+id/actionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnEndCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FF3B30"
            android:contentDescription="Termina Chiamata"
            app:borderWidth="0dp"
            app:elevation="8dp"
            app:fabCustomSize="76dp"
            app:maxImageSize="36dp"
            app:srcCompat="@drawable/ic_call_end"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAnswerCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:backgroundTint="#34C759"
            android:contentDescription="Rispondi"
            android:visibility="gone"
            app:borderWidth="0dp"
            app:elevation="8dp"
            app:fabCustomSize="76dp"
            app:maxImageSize="36dp"
            app:srcCompat="@drawable/ic_call"
            app:tint="@android:color/white"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>