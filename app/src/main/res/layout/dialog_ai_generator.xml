<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_transcribe"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_generate_with_ai"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_ai_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorControlNormal"
                android:contentDescription="@string/cd_ai_settings" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_generator_desc"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="24dp"/>

        <!-- CASSELLA INPUT PROMPT -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/ai_prompt_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_ai_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="5" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_quick_styles"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="8dp"/>

        <!-- SCROLL PRESETS CON CHIPGROUP A SELEZIONE SINGOLA (app:singleSelection="true") -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_presets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="false"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_cyberpunk"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_cyberpunk" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_landscape"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_landscape" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_abstract"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_abstract" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_space"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_space" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_rainy"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_lofi_rain" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_anime"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_anime" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_3d_avatar"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_3d_render" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_fantasy"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_fantasy" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_synthwave"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_synthwave" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset_dark_gothic"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_style_gothic" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- PULSANTE GENERA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_ai"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/action_generate_image"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_wallpaper"
            android:layout_marginBottom="16dp"/>

        <!-- CARICAMENTO -->
        <LinearLayout
            android:id="@+id/ai_loading_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_generating_wait"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary"/>
        </LinearLayout>

        <!-- ANTEPRIMA IMMAGINE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ai_preview_card"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ai_preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_ai_preview"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- PULSANTE APPLICA SFONDO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_set_generated_bg"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/action_set_as_background"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>