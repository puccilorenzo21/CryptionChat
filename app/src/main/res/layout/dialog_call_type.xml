<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_call"
        app:tint="?attr/colorPrimary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/call_dialog_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/call_dialog_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="24dp"/>

    <!-- Tasto Primario (EVIDENZIATO) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_call_normal"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_dialog_btn_normal"
        android:paddingVertical="12dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        android:layout_marginBottom="8dp"/>

    <!-- Tasto Secondario (MENO EVIDENTE) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_call_protected"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_dialog_btn_protected"
        android:textColor="?attr/colorError"
        app:strokeColor="?attr/colorError"
        app:icon="@drawable/ic_lock"
        app:iconTint="?attr/colorError"
        app:iconGravity="textStart"
        android:layout_marginBottom="8dp"/>

    <!-- Tasto Annulla -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_call_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_dialog_btn_cancel" />

</LinearLayout>