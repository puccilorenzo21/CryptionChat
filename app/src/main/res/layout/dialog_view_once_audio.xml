<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- HEADER: Icona + Titolo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_view_once"
            app:tint="?attr/colorPrimary"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_once_audio_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- PLAYER BOLLA (Stile chat ricevuta) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/play_pause_button"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:backgroundTint="?attr/colorOnSecondaryContainer"
                app:icon="@drawable/ic_play_arrow"
                app:iconTint="?attr/colorSecondaryContainer"
                app:iconSize="32dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/audio_thumb"
                    android:thumbTint="?attr/colorOnSecondaryContainer"
                    android:progressTint="?attr/colorOnSecondaryContainer"
                    android:progressBackgroundTint="?attr/colorOutlineVariant"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:minHeight="6dp" />

                <TextView
                    android:id="@+id/duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:alpha="0.9"
                    tools:text="00:15 / 00:45" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- AVVISO DI SICUREZZA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_once_audio_warning"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <!-- PULSANTE CHIUDI (Stile Distruttivo) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/close_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_close_and_destroy"
        android:textColor="?attr/colorError"
        android:textStyle="bold"
        android:paddingVertical="12dp"
        app:backgroundTint="?attr/colorErrorContainer"
        app:icon="@drawable/ic_delete_sweep"
        app:iconTint="?attr/colorError"
        app:iconGravity="textStart" />

</LinearLayout>