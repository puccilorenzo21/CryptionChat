<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="24dp">

    <!-- HEADER: Icona + Titolo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_view_once"
            app:tint="@android:color/white"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto Effimera"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- IMMAGINE (Occupa tutto lo spazio disponibile al centro) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="16dp">

        <!-- MODIFICATO: Aggiunto PhotoView per Zoom anche in effimero -->
        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/view_once_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            tools:src="@tools:sample/backgrounds/scenic"
            android:contentDescription="Immagine effimera con zoom"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- AVVISO DI SICUREZZA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Questa foto verrà distrutta permanentemente appena chiuderai questa finestra."
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="#FF8A8A"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <!-- PULSANTE CHIUDI -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/close_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chiudi e Distruggi"
        android:textColor="#FFB4AB"
        android:textStyle="bold"
        android:paddingVertical="12dp"
        app:backgroundTint="#93000A"
        app:icon="@drawable/ic_delete_sweep"
        app:iconTint="#FFB4AB"
        app:iconGravity="textStart" />

</LinearLayout>