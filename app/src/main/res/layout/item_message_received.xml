<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="80dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipToPadding="false">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profile_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="8dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        tools:src="@drawable/ic_person" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            tools:text="Username"/>

        <!-- Layout di contesto per le risposte (Reply) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/replyContextLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textViewReplyAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    tools:text="Tu"/>

                <TextView
                    android:id="@+id/textViewReplyContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Messaggio originale citato..."/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bolla del Messaggio -->
        <TextView
            android:id="@+id/textViewMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/message_bubble_received"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSecondaryContainer"
            tools:text="Questo è un messaggio ricevuto con un link maps: https://maps.google.com/?q=45.0,9.0"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColorLink="?attr/colorPrimary" />

        <!-- NUOVO: Info Distanza Stradale (Calcolata via OSRM) -->
        <TextView
            android:id="@+id/textViewDistanceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="🚗 Percorso stradale: 5.4 km (12 min)" />

        <!-- PULSANTI PER RICHIESTA POSIZIONE -->
        <LinearLayout
            android:id="@+id/locationRequestLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptLocation"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Condividi"
                app:icon="@drawable/ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeclineLocation"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:text="Rifiuta" />
        </LinearLayout>

        <!-- Contenitore Reazioni -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/reactions_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:flexWrap="wrap"
            android:visibility="gone"
            tools:visibility="visible">
        </com.google.android.flexbox.FlexboxLayout>

        <!-- Footer: Timestamp e stato Modificato -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textViewEditedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(modificato)"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/textViewTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                tools:text="10:30"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>