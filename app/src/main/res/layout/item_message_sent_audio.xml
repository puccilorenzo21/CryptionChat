<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="64dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipToPadding="false">

    <!-- Card Contenitore Messaggio -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
        android:layout_marginBottom="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minWidth="250dp">

            <!-- AREA RISPOSTA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/replyContextLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/textViewReplyAuthor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Username"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textAppearance="?attr/textAppearanceLabelMedium"/>

                    <TextView
                        android:id="@+id/textViewReplyContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Risposta..."
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textAppearance="?attr/textAppearanceBodySmall"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STRUTTURA PLAYER AUDIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Pulsante Play/Pause -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play_pause_button"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:backgroundTint="?attr/colorOnPrimary"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconTint="?attr/colorPrimary"
                    app:iconSize="24dp"
                    app:iconPadding="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <!-- Colonna Destra: Slider + Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <SeekBar
                        android:id="@+id/seek_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/audio_thumb"
                        android:thumbTint="?attr/colorOnPrimary"
                        android:progressTint="?attr/colorOnPrimary"
                        android:progressBackgroundTint="#80FFFFFF"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:minHeight="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:gravity="center_vertical">

                        <!-- Durata -->
                        <TextView
                            android:id="@+id/duration_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="00:15"
                            android:textColor="?attr/colorOnPrimary"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.9"/>

                        <!-- Timestamp + Status -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/textViewTimestamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="14:30"
                                android:textColor="?attr/colorOnPrimary"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textSize="10sp"
                                android:alpha="0.7"/>

                            <ImageView
                                android:id="@+id/imageViewStatus"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_check_all"
                                app:tint="?attr/colorOnPrimary"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackgroundBorderless"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- PULSANTE TRASCRIZIONE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_transcribe"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:padding="4dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_transcribe"
                    app:iconSize="20dp"
                    app:iconTint="?attr/colorOnPrimary"
                    app:rippleColor="?attr/colorOnPrimary"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/cd_transcribe_audio"/>

            </LinearLayout>

            <!-- CONTAINER TRASCRIZIONE DENTRO LA BOLLA INVIATA -->
            <LinearLayout
                android:id="@+id/transcription_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnPrimary"
                    android:alpha="0.3"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/transcription_progress_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/transcription_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnPrimary"
                        android:alpha="0.9"
                        android:layout_marginBottom="4dp"
                        tools:text="Decodifica audio in corso..." />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/transcription_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        app:trackCornerRadius="2dp"
                        app:indicatorColor="?attr/colorOnPrimary"
                        app:trackColor="#40FFFFFF"
                        android:max="100" />
                </LinearLayout>

                <TextView
                    android:id="@+id/transcription_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnPrimary"
                    android:textIsSelectable="true"
                    android:visibility="gone"
                    tools:text="Questo è il testo dell'audio trascritto..." />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- REAZIONI -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/reactions_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:flexWrap="wrap"
        app:justifyContent="flex_end"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>